generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum EstadoInscripcion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum Experiencia {
  NINGUNA
  MENOS_DE_UN_ANIO
  MAS_DE_UN_ANIO
}

model User {
  id            Int           @id @default(autoincrement())
  nombre        String
  email         String        @unique
  password      String
  role          Role          @default(USER)
  createdAt     DateTime      @default(now())
  inscripciones Inscripcion[]

  @@map("users")
}

model Categoria {
  clave   String   @id
  nombre  String
  edades  String
  resumen String
  trabajo String[]
  torneos String[]
  grupos  Grupo[]

  @@map("categorias")
}

model Entrenador {
  id               Int     @id @default(autoincrement())
  nombre           String
  especialidad     String
  experienciaAnios Int
  bio              String
  fotoUrl          String?
  grupos           Grupo[]

  @@map("entrenadores")
}

model Grupo {
  id             Int           @id @default(autoincrement())
  nombre         String
  categoriaClave String
  categoria      Categoria     @relation(fields: [categoriaClave], references: [clave], onDelete: Restrict, onUpdate: Cascade)
  edadMin        Int
  edadMax        Int
  dias           String
  horario        String
  precio         Int
  cupos          Int
  descripcion    String
  imagenUrl      String?
  entrenadorId   Int
  entrenador     Entrenador    @relation(fields: [entrenadorId], references: [id], onDelete: Restrict)
  inscripciones  Inscripcion[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoriaClave])
  @@map("grupos")
}

model Inscripcion {
  id                Int               @id @default(autoincrement())
  nombreAspirante   String
  edad              Int
  correo            String
  telefono          String
  experiencia       Experiencia
  nombreAcudiente   String?
  telefonoAcudiente String?
  permisoAcudiente  Boolean           @default(false)
  mensaje           String?           @db.VarChar(300)
  aceptaDatos       Boolean
  estado            EstadoInscripcion @default(PENDIENTE)
  userId            Int
  grupoId           Int
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  grupo             Grupo             @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())

  @@index([userId])
  @@map("inscripciones")
}